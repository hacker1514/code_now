# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_database_id
VITE_APPWRITE_COLLECTION_ID=your_collection_id
VITE_APPWRITE_QUESTION_CHALLENGES_DATABASE_ID=your_question_challenges_database_id
VITE_APPWRITE_QUESTION_CHALLENGES_COLLECTION_ID=your_question_challenges_collection_id
VITE_APPWRITE_QUESTION_COMPANY_TAG_COLLECTION_ID=your_question_company_tag_collection_id
VITE_APPWRITE_QUESTION_COMPANY_COLLECTION_ID=your_question_company_collection_id
VITE_APPWRITE_QUESTION_MICELLANEOUS_COLLECTION_ID=your_question_miscellaneous_collection_id
VITE_APPWRITE_FEEDBACK_DATABASE_ID=your_feedback_database_id
VITE_APPWRITE_FEEDBACK_COLLECTION_ID=your_feedback_collection_id
VITE_APPWRITE_FEATURES_REQUEST_COLLECTION_ID=your_features_request_collection_id
VITE_APPWRITE_UPCOMING_FEATURES_COLLECTION_ID=your_upcoming_features_collection_id

# Backend URL
VITE_BACKEND_URL=http://localhost:5000

# OAuth Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback/github
